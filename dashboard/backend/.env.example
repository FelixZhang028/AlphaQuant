# Copy to .env. Blank APP_SECRET generates a persistent local random key.
# AI keys and models, AI daily limits, the daily data update, the BaoStock interval and SMTP can also be
# set by an administrator in the admin console (系统设置); values saved there take precedence over this file.
APP_SECRET=
# Optional first-run admin account (password: at least 12 characters)
FELLOWQUANT_ADMIN_EMAIL=
FELLOWQUANT_ADMIN_PASSWORD=
# Text model for AI researcher and one-sentence rules; also a fallback provider for Jev
OPENROUTER_API_KEY=
# Official TypeSafe Jev key, kept only on the backend. JEV_API_KEY is also accepted.
TYPESAFE_API_KEY=
# Optional: another model or OpenAI-compatible service, and free uses per user per day (admins unlimited)
FELLOWQUANT_AI_MODEL=
FELLOWQUANT_AI_BASE_URL=
FELLOWQUANT_AI_API_KEY=
FELLOWQUANT_AI_DAILY_BRIEFS=3
FELLOWQUANT_AI_DAILY_QUESTIONS=10
FELLOWQUANT_AI_DAILY_STRATEGIES=5
FELLOWQUANT_AI_DAILY_REVIEWS=3
FELLOWQUANT_AI_DAILY_DECISIONS=3
# AI Q&A (floating window in the workspace): free questions per user per day
FELLOWQUANT_AI_DAILY_CHATS=10
# Points: after the free uses each use costs points. Sign-up gift (once per account), how many days gifted
# points stay valid, at most this many AI uses per person per day (0: no cap), and the cost of each kind.
FELLOWQUANT_POINTS_SIGNUP=100
FELLOWQUANT_POINTS_GIFT_DAYS=30
FELLOWQUANT_POINTS_DAILY_CAP=200
FELLOWQUANT_POINTS_COST_BRIEF=3
FELLOWQUANT_POINTS_COST_QUESTION=1
FELLOWQUANT_POINTS_COST_STRATEGY=2
FELLOWQUANT_POINTS_COST_REVIEW=2
FELLOWQUANT_POINTS_COST_DECISION=2
FELLOWQUANT_POINTS_COST_CHAT=2
# Optional Jev overrides: TypeSafe defaults to jev-latest at /v1/systemone;
# OpenRouter defaults to typesafe/jev-1.13 at /api/alpha/decisions.
FELLOWQUANT_JEV_MODEL=
FELLOWQUANT_JEV_URL=
# Daily market-wide data update after the close (China time); off disables it, admins can still run it by hand
FELLOWQUANT_DAILY_UPDATE=on
FELLOWQUANT_DAILY_UPDATE_TIME=18:30
# Financial reports during report seasons, Saturdays after 10:00 (China time); off disables it
FELLOWQUANT_FUNDAMENTALS_UPDATE=on
# Seconds between two BaoStock requests; BaoStock blacklists servers that ask too fast for a while
FELLOWQUANT_BAOSTOCK_INTERVAL=0.1
# AI researcher factor profile: precompute the newest trading day's factor values for the whole market; off disables it
FELLOWQUANT_FACTOR_PROFILE=on
# Heavy computations (backtests, parameter checks, factor research): at once on the server, per user,
# seconds each, and how many factor results to remember. Blank uses the defaults.
FELLOWQUANT_COMPUTE_SLOTS=
FELLOWQUANT_COMPUTE_PER_USER=1
FELLOWQUANT_COMPUTE_TIMEOUT=600
FELLOWQUANT_COMPUTE_CACHE=64
# Whole-site AI calls per day (admins not counted); when used up, AI pauses for everyone until tomorrow
FELLOWQUANT_AI_DAILY_TOTAL=500
# Optional integrations (WeKnora can also be set by an admin in the page)
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
# Optional password reset mail (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Registration (usually set in the admin console instead, which takes precedence once used):
# invite codes as CODE:uses (comma separated, no :uses = unlimited) require a code;
# FELLOWQUANT_REGISTRATION=closed always stops sign-ups; both blank = open registration
FELLOWQUANT_REGISTRATION=
FELLOWQUANT_INVITE_CODES=
# Behind Cloudflare use CF-Connecting-IP (Nginx: X-Real-IP) so rate limits see the real visitor IP
FELLOWQUANT_CLIENT_IP_HEADER=
# Deployment: allowed browser origins (comma separated; not needed when one address serves both),
# built site and admin console folders served by the backend (scripts/serve.ps1 sets them),
# API docs at /docs (on/off), largest request in MB
FELLOWQUANT_CORS_ORIGINS=
FELLOWQUANT_STATIC_DIR=
FELLOWQUANT_ADMIN_DIR=
FELLOWQUANT_API_DOCS=off
FELLOWQUANT_MAX_BODY_MB=5
# Daily backup of accounts, login key and settings (market data is not backed up); keep N days
FELLOWQUANT_BACKUP=on
FELLOWQUANT_BACKUP_DIR=
FELLOWQUANT_BACKUP_KEEP=14
