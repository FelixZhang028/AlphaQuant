# Copy to .env. Blank APP_SECRET generates a persistent local random key.
APP_SECRET=
# Optional first-run admin account (password: at least 12 characters)
FELLOWQUANT_ADMIN_EMAIL=
FELLOWQUANT_ADMIN_PASSWORD=
# AI model the platform provides to all users (AI researcher, one-sentence rules); also used by Jev
OPENROUTER_API_KEY=
# Optional: another model or OpenAI-compatible service, and daily limits per user (admins unlimited)
FELLOWQUANT_AI_MODEL=
FELLOWQUANT_AI_BASE_URL=
FELLOWQUANT_AI_API_KEY=
FELLOWQUANT_AI_DAILY_BRIEFS=5
FELLOWQUANT_AI_DAILY_QUESTIONS=20
FELLOWQUANT_AI_DAILY_STRATEGIES=10
# Optional integrations
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
# Optional password reset mail (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
